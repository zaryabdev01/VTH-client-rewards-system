# ---------- Database ----------
# Leave DATABASE_URL empty for local dev: an embedded Postgres (PGlite) is created in ./.data and seeded with demo data.
# Production: a managed PostgreSQL connection string (Neon / Supabase / RDS).
DATABASE_URL=
AUTO_MIGRATE=true            # run migrations on boot (or run `npm run db:migrate` in CI instead)

# ---------- Public site ----------
APP_URL=http://localhost:3000   # used for links inside emails
EMBED_ALLOWED_ORIGINS=          # space/comma list of VTH site origins allowed to embed the spin page in an iframe, e.g. https://www.vth.co.uk

# ---------- Security ----------
APP_SECRET=                     # >=32 random chars; signs the short-lived spin pass (generate: openssl rand -hex 32)
RATE_SALT=                      # random string; used to hash IPs before storing them
CRON_SECRET=                    # protects /api/cron/renewals (Vercel Cron sends it automatically)
# Cloudflare Turnstile (bot protection on code entry). Leave both empty to disable (local dev).
# NEXT_PUBLIC_ is baked in at BUILD time -> redeploy after changing the site key.
# Cloudflare official TEST keys (always pass) for dev/preview:  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
# Use a SEPARATE real widget (own keys) for production, with the production hostname registered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Email ----------
# Delivery order: SMTP (the client's own settings) -> Resend -> log only.
SMTP_HOST=                      # e.g. smtp.office365.com  (set this and emails go out via SMTP)
SMTP_PORT=587                   # 587 (STARTTLS) or 465 (SSL)
SMTP_SECURE=                    # leave empty (auto: true on port 465); set true/false to force
SMTP_USER=
SMTP_PASS=
# Alternative provider (used only if SMTP_HOST is empty):
RESEND_API_KEY=                 # empty = emails are logged to the console + email_log table instead of sent
EMAIL_FROM="VTH Thank You Spin <rewards@vth.co.uk>"   # must be an address the SMTP account / Resend domain may send as
EMAIL_REPLY_TO=

# ---------- First admin (production) ----------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="VTH Admin"
BOOTSTRAP_ADMIN_PASSWORD=       # >=10 chars; remove this variable after first boot

# ---------- Demo / staging only ----------
NEXT_PUBLIC_DEMO=               # 1 = show the review guide + quick sign-in buttons. NEVER set in production.
